# Firebase Web App config
# Copy these values from Firebase Console > Project settings > General > Your apps > Web app.
# In Vercel, add the same keys under Project Settings > Environment Variables.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional but useful if Firebase Analytics is enabled for the web app.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional app-level defaults.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# Fixed admin account metadata. Use the UID from Firebase Auth after creating the admin account.
NEXT_PUBLIC_ADMIN_EMAIL=
FIREBASE_ADMIN_UID=
FIREBASE_ADMIN_EMAIL=
FIREBASE_ADMIN_PASSWORD=

# Required by `npm run firebase:seed` when Firestore rules are in production mode.
# Use either JSON string or base64-encoded service account JSON. Do not expose these in client code.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Cloudinary unsigned upload config for CMS media uploads.
# Cloudinary Console > Settings > Upload > Upload presets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
