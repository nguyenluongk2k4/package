rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function published() {
      return resource.data.status == "published";
    }

    match /adminUsers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /stations/{stationId} {
      allow read: if published() || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if published() || isAdmin();
      allow write: if isAdmin();
    }

    match /arCharacters/{characterId} {
      allow read: if resource.data.status == "active" || resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();

      match /cart/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }

      match /journeyProgress/{stationId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }

      match /photoboothPhotos/{photoId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }

      match /arExperiences/{sessionId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }

      match /adminEvents/{eventId} {
        allow read, write: if isAdmin();
      }
    }

    match /orders/{orderId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();

      match /events/{eventId} {
        allow list: if isAdmin();
        allow get: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
        allow create: if isAdmin() || (
          signedIn()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == "user"
          && request.resource.data.type == "order_created"
        );
        allow update, delete: if isAdmin();
      }
    }

    match /activationCodes/{code} {
      // Cho phép mọi người dùng đã đăng nhập đọc trạng thái của mã kích hoạt
      allow read: if signedIn();
      
      // Chỉ cho phép người dùng tự kích hoạt mã nếu mã đang ở trạng thái 'active'
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.status == "active"
        && request.resource.data.status == "used"
        && request.resource.data.usedBy == request.auth.uid
      );
        
      // Chỉ quản trị viên mới được tạo mới hoặc xóa mã kích hoạt
      allow create, delete: if isAdmin();

      match /events/{eventId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
